# Update System & Install Git
sudo apt update
sudo apt install git -y
git --version

# Configure Git User
git config --global user.name "Shan Zafar"
git config --global user.email "your-email@gmail.com"
git config --list

# Create Project & Initialize Git
mkdir devops-project
cd devops-project
git init

# Create First File
touch file1.txt
echo "Hello from Server 1" > file1.txt

# Add Remote Repository
git remote add origin https://github.com/your-username/your-repo.git

# First Commit & Push
git add .
git commit -m "First commit from server 1"
git push -u origin main

# Clone Repository on Another Server
git clone https://github.com/your-username/your-repo.git
cd your-repo

# Update File & Push Changes
echo "Update from Server 2" >> file1.txt
git add .
git commit -m "Update from server 2"
git push

# Pull Latest Changes
git pull

# Create & Switch to New Branch
git branch feature-branch
git checkout feature-branch

# Add Feature Work
echo "Feature work" >> file1.txt
git add .
git commit -m "Feature added"
git push origin feature-branch

# Merge Branch into Main
git checkout main
git merge feature-branch

# Git Stash Example
echo "Temp change" >> file1.txt
git stash
git stash pop

# View Commit History
git log

# Reset Last Commit
git reset --hard HEAD~1

# Revert Specific Commit
git revert commit-id

# Clone Repository Again
git clone https://github.com/your-username/your-repo.git

# One-Line Commit History
git log --oneline
